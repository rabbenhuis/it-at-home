[Unit]
Description=AdGuard Home: Network-level blocker
After=network.target

[Service]
Type=notify
WorkingDirectory={{ adguard_install_dir }}
ExecStart={{ adguard_install_dir }}/AdGuardHome -s run -c {{ adguard_install_dir }}/AdGuardHome.yaml
Restart=always
RestartSec=5
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target