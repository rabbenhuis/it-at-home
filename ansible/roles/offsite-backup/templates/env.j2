# Managed by the offsite-backup ansible role. Root-only; contains restic repo
# URLs (with credentials) and repo passwords. One BACKUP_DEST_<NAME>_* pair per
# destination, consumed by /usr/local/sbin/offsite-backup.sh.
{% for d in backup_restic_destinations %}
BACKUP_DEST_{{ d.name | upper }}_REPO={{ d.repo }}
BACKUP_DEST_{{ d.name | upper }}_PASSWORD={{ d.password }}
{% endfor %}