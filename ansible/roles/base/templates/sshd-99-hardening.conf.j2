# Managed by Ansible

# Permit password-based login only for the initial build; keys only afterwards.
PasswordAuthentication no
PermitEmptyPasswords no

# Root can only be reached via console / physical access.
PermitRootLogin no

MaxAuthTries 3
MaxSessions 2
AllowTcpForwarding no
AllowAgentForwarding no
ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE
TCPKeepAlive no
PubkeyAuthentication yes
Ciphers aes128-ctr,aes192-ctr,aes256-ctr
HostbasedAuthentication no
IgnoreRhosts yes
X11Forwarding no

# Keyboard-interactive is a second password channel; disable to make
# PasswordAuthentication no actually effective.
KbdInteractiveAuthentication no