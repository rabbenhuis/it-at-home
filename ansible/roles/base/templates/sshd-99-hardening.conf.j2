# Managed by Ansible

# Permit password-based login only for the initial build; keys only afterwards.
PasswordAuthentication no
PermitEmptyPasswords no
KbdInteractiveAuthentication no
AuthenticationMethods publickey

# Root can only be reached via console / physical access.
PermitRootLogin no

MaxAuthTries 3
MaxSessions 2
LoginGraceTime 30
AllowTcpForwarding no
AllowAgentForwarding no
ClientAliveInterval 300
ClientAliveCountMax 2
LogLevel VERBOSE
TCPKeepAlive no
PubkeyAuthentication yes
Ciphers aes128-ctr,aes192-ctr,aes256-ctr
HostbasedAuthentication no
IgnoreRhosts yes
X11Forwarding no

# Restrict SSH access to the admin users only. debian is the cloud-init build
# user on VM templates (only present there); it must stay allowed or the VM
# template build gets locked out mid-run (ansible connects as debian, and the
# sshd change kills new connections when the control socket expires).
AllowUsers ansible sysadm1n debian