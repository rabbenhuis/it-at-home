# Managed by Ansible
defaults
auth on
tls on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile /var/log/msmtp.log

account default
host {{ msmtp_host }}
port {{ msmtp_port }}
from {{ msmtp_from }}
{% if msmtp_user | length > 0 %}
user {{ msmtp_user }}
password {{ msmtp_password }}
{% endif %}