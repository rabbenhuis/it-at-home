SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

0 5 1 * * root /usr/sbin/lynis --cronjob --quiet --report-file /var/log/lynis-report.html; { echo "Lynis scan - $(hostname)"; echo "Datum: $(date '+\%Y-\%m-\%d \%H:\%M')"; echo "Hardening index: $(grep -m1 '^hardening_index=' /var/log/lynis-report.html | cut -d= -f2)"; echo "Warnings: $(grep -c '^warning\[\]=' /var/log/lynis-report.html)"; echo "Suggestions: $(grep -c '^suggestion\[\]=' /var/log/lynis-report.html)"; } | /usr/local/bin/send-mail

35 5 1 * * root OUT=$(debsums -s 2>&1) && [ -n "$OUT" ] && { echo "debsums check - $(hostname)"; echo "Datum: $(date '+\%Y-\%m-\%d \%H:\%M')"; echo "$OUT"; } | /usr/local/bin/send-mail || true

20 3 * * 1 root rkhunter --update >/dev/null 2>&1; OUT=$(rkhunter --check --skip-keypress --report-warnings-only 2>/dev/null); [ -n "$OUT" ] && { echo "rkhunter check - $(hostname)"; echo "Datum: $(date '+\%Y-\%m-\%d \%H:\%M')"; echo "$OUT"; } | /usr/local/bin/send-mail || true

10 3 * * 1 root OUT=$(debsecan --format detail --suite {{ ansible_distribution_release }} --only-fixed 2>/dev/null); [ -n "$OUT" ] && { echo "debsecan check - $(hostname)"; echo "Datum: $(date '+\%Y-\%m-\%d \%H:\%M')"; echo "$OUT"; } | /usr/local/bin/send-mail || true

0 7 * * * root [ -f /var/run/reboot-required ] && { echo "Restart required - $(hostname)"; echo "Datum: $(date '+\%Y-\%m-\%d \%H:\%M')"; echo; cat /var/run/reboot-required.pkgs 2>/dev/null; } | /usr/local/bin/send-mail || true
